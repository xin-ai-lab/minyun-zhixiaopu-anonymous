# ============================================================================
# 环境变量模板 —— 复制本文件为 .env 后按需修改
#
#   cp .env.example .env
#
# 说明：
#   1. .env 已被 .gitignore 忽略，不会进入公开仓库；
#   2. 修改后执行 `npm run env`，脚本会把变量注入 src/js/env.generated.js；
#   3. 若整份 .env 缺失，应用会自动回退到内置的「公开安全默认值」，
#      因此克隆仓库后即可直接运行，无需任何配置。
# ============================================================================

# ---- 应用展示信息 ----
APP_NAME=闽韵智小铺
APP_SUBTITLE=福建非遗智能科普助手

# ---- 地图瓦片地址（默认高德路网，无需密钥；可换成自建瓦片服务） ----
# 支持 {s} 子域占位符、{x}/{y}/{z} 瓦片坐标占位符
MAP_TILE_URL=https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}

# ---- 开放图库检索接口（默认维基共享资源，CC 授权） ----
WIKI_API_BASE=https://commons.wikimedia.org/w/api.php

# ---- 可选：接入在线大模型（留空则使用内置本地规则引擎，无需联网） ----
# 注意：API Key 属敏感信息，切勿硬编码进源码或提交到仓库
AI_API_BASE=
AI_API_KEY=
AI_MODEL=deepseek-chat
